# === DATABASE ===
DATABASE_URL=sqlite:///./coincheckgo.db
# Khi scale: DATABASE_URL=postgresql://user:pass@host:5432/coincheckgo

# === APIFY ===
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxx
APIFY_TWITTER_ACTOR_ID=nfp1fpt5gUlBwPcor
# Lấy tại: https://console.apify.com/account/integrations

# === OPENGRADIENT ===
OPENGRADIENT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Tạo wallet mới dành riêng cho project, đừng dùng wallet chính

# === SOLANA ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Recommended: Dùng Helius (free tier 100k requests/day)
HELIUS_API_KEY=your_helius_key_here
# Lấy tại: https://dev.helius.xyz/

# === APP CONFIG ===
CACHE_TTL_MINUTES=15
MAX_TWEETS_PER_SCAN=100
DEBUG=false
